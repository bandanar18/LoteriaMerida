PORT=3000
DATABASE_URL=postgres://loteria:loteria_dev@localhost:5433/loteria
# Generar uno propio en producción: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-cambia-este-secreto-en-produccion
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
# Ejecutar el ciclo de vida de sorteos (abrir/cerrar/sortear/liquidar) en esta instancia
LOTTERY_SCHEDULER=true
# Simulador del jugador (recarga de prueba + sorteo privado al instante). Nunca activarlo en producción.
SIMULATION_MODE=true
# Deportes en pausa: solo animalitos. Poner true para reactivar la sección de deportes.
SPORTS_ENABLED=false
# Cuotas reales (The Odds API, plan gratis = 500 créditos/mes). Sin llave el trader carga los eventos a mano.
# Llave gratis en https://the-odds-api.com. Cada liga consulta cuesta mercados × regiones (h2h,totals × 1 región = 2).
ODDS_API_KEY=
# ODDS_API_REGIONS=eu
# ODDS_API_INTERVAL_MINUTES=1440
# ODDS_API_CREDITS_PER_SYNC=16
# ODDS_API_HORIZON_DAYS=7
# ODDS_API_LEAGUES=basketball_nba,icehockey_nhl,soccer_conmebol_copa_libertadores
# Número de licencia mostrado en el pie de página y en tickets (REG-06)
LICENSE_LABEL=MVP de demostración — sin licencia, solo dinero ficticio

# Datos de cobro mostrados al jugador (ficticios)
PAY_PAGO_MOVIL_BANK=0102 - Banco de Venezuela
PAY_PAGO_MOVIL_PHONE=0414-0000000
PAY_PAGO_MOVIL_DOC=J-00000000-0
PAY_USDT_NETWORK=TRC-20
PAY_USDT_ADDRESS=TXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cuentas de staff de prueba creadas por `npm run seed` (solo entorno local)
SEED_ADMIN_EMAIL=admin@loteria.test
SEED_ADMIN_PASSWORD=Admin.Dev.2026!
SEED_SUPERVISOR_EMAIL=supervisor@loteria.test
SEED_SUPERVISOR_PASSWORD=Supervisor.Dev.2026!
SEED_PLAYER_EMAIL=jugador@loteria.test
SEED_PLAYER_PASSWORD=Jugador.Dev.2026!
SEED_COMPLIANCE_EMAIL=cumplimiento@loteria.test
SEED_COMPLIANCE_PASSWORD=Cumplimiento.Dev.2026!
SEED_TRADER_EMAIL=trader@loteria.test
SEED_TRADER_PASSWORD=Trader.Dev.2026!

# KYC: documentos cifrados con AES-256-GCM fuera de la BD
KYC_STORAGE_DIR=storage/kyc
# Solo desarrollo. Generar uno propio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Retardo de aceptación de apuestas en vivo (ms)
LIVE_BET_DELAY_MS=5000

# 5 jugadores de prueba (prueba1..prueba5@fortunabet.test), misma contraseña. Cámbiala en tu .env
SEED_TEST_PLAYERS_PASSWORD=CambiaEsta.Clave1
# Bono de bienvenida DEMO por registro
SIGNUP_BONUS_VES=10000
SIGNUP_BONUS_USDT=10
